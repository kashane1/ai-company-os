---
// Post-submit confirmation page for the contact form (contact_forms service).
// The contact Netlify function 303-redirects here after capturing a lead.
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thanks — we got your message</title>
  <meta name="robots" content="noindex" />
</head>
<body>
  <main class="section">
    <div class="container center stack-lg">
      <h1>Thanks, we got your message.</h1>
      <p class="muted">We'll get back to you as soon as we can.</p>
      <a class="btn btn-primary btn-lg" href="/">Back to home</a>
    </div>
  </main>
</body>
</html>
