---
// Sticky process — a pinned heading beside a stepped, scroll-revealed list.
// `data`: { heading, steps[{title, body}] }.
const { data } = Astro.props;
const { heading, steps = [] } = data;
---
<section class="section" style="border-top:1px solid var(--border)">
  <div class="container" style="display:grid;gap:clamp(1.5rem,5vw,5rem);grid-template-columns:minmax(0,0.8fr) minmax(0,1.2fr);align-items:start">
    <div style="position:sticky;top:3rem">
      <h2 data-reveal style="font-size:var(--step-3)">{heading}</h2>
    </div>
    <ol style="list-style:none;margin:0;padding:0;display:grid;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden">
      {steps.map((s, i) => (
        <li data-reveal style="background:var(--canvas);padding:1.5rem">
          <div style="font-family:var(--mono-font);color:var(--accent-text,var(--accent));font-size:var(--step-n1)">{String(i + 1).padStart(2, "0")}</div>
          <h3 style="font-size:var(--step-1);margin-top:0.5rem">{s.title}</h3>
          {s.body && <p class="muted" style="margin:0.5rem 0 0">{s.body}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @media (max-width: 720px) {
    section > .container { grid-template-columns: 1fr !important; }
    section [style*="sticky"] { position: static !important; }
  }
</style>
