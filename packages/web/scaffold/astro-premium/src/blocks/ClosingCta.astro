---
// Closing CTA — centered, glowing, single decisive action. `data`: { headline,
// subhead, cta }.
const { data } = Astro.props;
const { headline, subhead, cta } = data;
---
<section id="get-started" class="section">
  <div class="container glow" style="text-align:center;max-width:40rem;position:relative">
    <h2 data-reveal style="font-size:var(--step-4)">{headline}</h2>
    {subhead && <p class="muted" data-reveal style="margin-top:1rem;font-size:var(--step-1)">{subhead}</p>}
    {cta && <a class="btn btn-primary" data-reveal href="#" style="margin-top:1.75rem">{cta}</a>}
  </div>
</section>
