---
// Cinematic hero — full-bleed, WebGL aurora behind an editorial headline.
// Consumes only role tokens; content comes from the composer via `data`.
const { data } = Astro.props;
const { eyebrow, headline, subhead, primaryCta, secondaryCta, secondaryHref = "#approach" } = data;
---
<section class="section glow" data-hero style="position:relative;overflow:hidden">
  <canvas data-hero-canvas aria-hidden="true"
          style="position:absolute;inset:0;width:100%;height:100%;z-index:-1;opacity:0.9"></canvas>
  <div class="container" style="max-width:54rem">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 data-reveal style="margin-top:1rem">{headline}</h1>
    {subhead && <p class="muted" data-reveal style="font-size:var(--step-1);max-width:42rem;margin-top:1.25rem">{subhead}</p>}
    <div data-reveal style="display:flex;gap:0.75rem;margin-top:2rem;flex-wrap:wrap">
      {primaryCta && <a class="btn btn-primary" href="#get-started">{primaryCta}</a>}
      {secondaryCta && <a class="btn btn-ghost" href={secondaryHref}>{secondaryCta}</a>}
    </div>
  </div>
</section>
