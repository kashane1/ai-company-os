# AI Company OS — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will never be committed.

# ── Image Generation (Lane 3: Content Factory) ──────────────
# Google Gemini API — free tier, 15 req/min
# Get yours at: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# ── Social Media Scheduling (Lane 4: Postiz) ────────────────
# Postiz API key — $29/mo hosted plan
# Get yours at: https://postiz.com (Settings → API Keys)
POSTIZ_API_KEY=

# ── Monetization (Lane 1: RevenueCat) ───────────────────────
# RevenueCat public API key — free until $2.5k/mo revenue
# Get yours at: https://app.revenuecat.com (Project → API Keys)
# Note: the iOS SDK uses the public key, not the secret key
REVENUECAT_API_KEY=

# ── AI Reasoning (OpenRouter) ───────────────────────────────
# OpenRouter API key — used for text/reasoning tasks, incl. the discovery
# analyst (LLMSignalProvider). Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── AI Reasoning (NVIDIA NIM) ───────────────────────────────
# NVIDIA's free, OpenAI-compatible inference API — 100+ open models (chat,
# reasoning, vision, embeddings). Generous free tier. An alternative/additional
# provider to OpenRouter; selectable via build_chat_model("nvidia").
# Get yours at: https://build.nvidia.com (model page → "Get API Key")
NVIDIA_API_KEY=

# Optional: default chat-model provider used by build_chat_model() / the
# discovery analyst when no provider is passed. One of: openrouter, nvidia,
# nvidia:reasoning. Defaults to openrouter.
# CHAT_MODEL_PROVIDER=openrouter

# ── Discovery sources ───────────────────────────────────────
# GitHub: a personal access token (no scopes needed for public search).
# https://github.com/settings/tokens
GITHUB_TOKEN=
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# (redirect uri http://localhost:8080). The client id is shown under the app
# name; the secret is the "secret" field. The connector uses app-only OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google Places API (New): used by Phase 1 local-SMB prospecting via official
# Places endpoints only. No Google Maps HTML scraping or review text storage.
GOOGLE_PLACES_API_KEY=

# Prospect web-presence verification: use one or both. Brave is a single search
# request per prospect and has monthly free credits. DataForSEO is usually
# cheaper at volume through the Google Organic SERP standard queue.
BRAVE_SEARCH_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Open-source prospect collection. FSQ OS Places currently comes from a
# Foursquare portal export/catalog path; Overture uses public S3 by default.
FSQ_OS_PLACES_PATH=

# Google Maps demo key (browser-side): embeds a map of the business location on
# the demo/prospect sites we ship (Maps Embed API; optional Static Maps). Kept
# separate from GOOGLE_PLACES_API_KEY so it can be HTTP-referrer-restricted and
# safely appear in client-side markup. Consumed by packages/agency/demo_maps.py.
# GOTCHA: the key must belong to a GCP project YOU control with "Maps Embed API"
# enabled — a key from someone else's demo/sample project returns HTTP 403
# "This API is not activated on your API project" and can't be fixed in code.
# Validate any key with: python scripts/agency/smoke_test_maps_key.py
# Currently SHELVED: no demo template calls demo_maps yet, so a missing/invalid
# key is harmless (embed_iframe_html() returns "").
GOOGLE_MAPS_DEMO_API_KEY=

# ── Web deploy lane (Netlify) ───────────────────────────────
# Personal access token for the Netlify API — used by the WEBDEPLOY worker to
# create sites and publish builds. Netlify's free tier permits commercial use.
# Create one at: https://app.netlify.com/user/applications#personal-access-tokens
# Treat as a gated secret (production deploys + DNS are approval-gated).
NETLIFY_AUTH_TOKEN=

# ── Payments (Stripe) ───────────────────────────────────────
# Secret API key for Stripe Checkout on monetized landing pages. Use a TEST key
# (sk_test_…) for validation — no approval needed. A LIVE key (sk_live_…) moves
# real money and is approval-gated by the platform. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook (checkout.session.completed → paid
# validation). From the webhook endpoint settings in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Bundle → Stripe price-id map (JSON). Price ids are mode-scoped and NOT catalog
# data. Recreate prices in live mode and add the "live" block before going live.
# {"package_c":{"test":{"setup":"price_…","monthly":"price_…"}}}
STRIPE_PRICE_MAP=

# ── Analytics (Plausible) ───────────────────────────────────
# Stats API key for real visit/lead numbers in the monthly report. The client
# site must fire a "Form Lead" custom-event goal for lead counts to exist.
# https://plausible.io/docs/stats-api
PLAUSIBLE_API_KEY=
# Cloud default is https://plausible.io; set this to a self-hosted instance URL.
PLAUSIBLE_BASE_URL=

# ── Inbound lead notification (Resend) ──────────────────────
# Server-side only. Set these in Netlify env for the Better Business Web site so
# the website-review function emails the operator on each submission. NEVER add a
# PUBLIC_/VITE_ prefix and never let these reach dist/ (the deploy refuses to ship
# a build that contains a re_… key). https://resend.com/api-keys
RESEND_API_KEY=
# Recipient for new-lead notifications. Defaults to ksakhakorn@gmail.com in the
# function if unset; swap to a business inbox later with no source change.
LEAD_NOTIFY_EMAIL=
# Verified Resend sender (e.g. "Lead Bot <leads@mail.yourdomain.com>"). Must be on
# a domain verified in Resend (SPF+DKIM) before real sends.
LEAD_FROM_EMAIL=

# ── Database (optional) ─────────────────────────────────────
# Falls back to local SQLite if not set. Use scripts/control_plane_db.py init to
# create schema and scripts/control_plane_db.py migrate-sqlite to copy SQLite
# records into Postgres.
# AI_COMPANY_OS_DATABASE_URL=postgresql://ai_company:ai_company@localhost:5432/ai_company_os

# ── Queue backend (optional) ────────────────────────────────
# database = durable DB-backed queue (default). redis = Redis Streams dispatch
# with Postgres/SQLite as the canonical task store.
# AI_COMPANY_OS_QUEUE_BACKEND=database
# AI_COMPANY_OS_REDIS_URL=redis://127.0.0.1:6379/0
