# AI Company OS — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will never be committed.

# ── Image Generation (Lane 3: Content Factory) ──────────────
# Google Gemini API — free tier, 15 req/min
# Get yours at: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# ── Social Media Scheduling (Lane 4: Postiz) ────────────────
# Postiz API key — $29/mo hosted plan
# Get yours at: https://postiz.com (Settings → API Keys)
POSTIZ_API_KEY=

# ── Monetization (Lane 1: RevenueCat) ───────────────────────
# RevenueCat public API key — free until $2.5k/mo revenue
# Get yours at: https://app.revenuecat.com (Project → API Keys)
# Note: the iOS SDK uses the public key, not the secret key
REVENUECAT_API_KEY=

# ── AI Reasoning (OpenRouter) ───────────────────────────────
# OpenRouter API key — used for text/reasoning tasks, incl. the discovery
# analyst (LLMSignalProvider). Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── AI Reasoning (NVIDIA NIM) ───────────────────────────────
# NVIDIA's free, OpenAI-compatible inference API — 100+ open models (chat,
# reasoning, vision, embeddings). Generous free tier. An alternative/additional
# provider to OpenRouter; selectable via build_chat_model("nvidia").
# Get yours at: https://build.nvidia.com (model page → "Get API Key")
NVIDIA_API_KEY=

# Optional: default chat-model provider used by build_chat_model() / the
# discovery analyst when no provider is passed. One of: openrouter, nvidia,
# nvidia:reasoning. Defaults to openrouter.
# CHAT_MODEL_PROVIDER=openrouter

# ── Discovery sources ───────────────────────────────────────
# GitHub: a personal access token (no scopes needed for public search).
# https://github.com/settings/tokens
GITHUB_TOKEN=
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# (redirect uri http://localhost:8080). The client id is shown under the app
# name; the secret is the "secret" field. The connector uses app-only OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Web deploy lane (Netlify) ───────────────────────────────
# Personal access token for the Netlify API — used by the WEBDEPLOY worker to
# create sites and publish builds. Netlify's free tier permits commercial use.
# Create one at: https://app.netlify.com/user/applications#personal-access-tokens
# Treat as a gated secret (production deploys + DNS are approval-gated).
NETLIFY_AUTH_TOKEN=

# ── Payments (Stripe) ───────────────────────────────────────
# Secret API key for Stripe Checkout on monetized landing pages. Use a TEST key
# (sk_test_…) for validation — no approval needed. A LIVE key (sk_live_…) moves
# real money and is approval-gated by the platform. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook (checkout.session.completed → paid
# validation). From the webhook endpoint settings in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# ── Database (optional) ─────────────────────────────────────
# Falls back to local SQLite if not set
# AI_COMPANY_OS_DATABASE_URL=postgresql://user:pass@localhost:5432/aicos
