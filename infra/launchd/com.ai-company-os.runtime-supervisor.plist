<?xml version="1.0" encoding="UTF-8"?>
<!-- Render using scripts/render_launch_agent.py; see the adjacent README. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-company-os.runtime-supervisor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/.venv/bin/python</string>
    <string>__REPO_ROOT__/apps/runtime-supervisor/main.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AI_COMPANY_OS_REPO_ROOT</key>
    <string>__REPO_ROOT__</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/state/logs/runtime-supervisor/launchd.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/state/logs/runtime-supervisor/launchd.err.log</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
