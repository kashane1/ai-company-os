__pycache__/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/
.mypy_cache/
build/
.coverage
*.egg-info/

# Secrets — never commit actual .env files
.env
.env.local
.env.*.local

state/repos/*
state/worktrees/*
state/artifacts/*
state/checkpoints/*
state/logs/*
state/prospects/*
state/handshake/
state/postmortems/

!state/repos/.gitkeep
!state/worktrees/.gitkeep
!state/artifacts/.gitkeep
!state/checkpoints/.gitkeep
!state/logs/.gitkeep
!state/prospects/.gitkeep

# Claude Code agent worktrees — each one is its own checkout of the repo,
# must never be committed back into the parent tree.
.claude/worktrees/

# Xcode per-user UI state — binary, machine-specific, changes on every open.
xcuserdata/
*.xcuserstate

.claude/scheduled_tasks.lock

# Codex desktop/app-local hooks and session metadata.
.codex/
