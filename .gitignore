__pycache__/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/
.mypy_cache/
build/
.coverage
.coverage.*
*.egg-info/

# Secrets — never commit actual .env files
.env
.env.local
.env.*.local

# Runtime records, reports, assets, tokens, and local worktrees stay private.
# Only the contract and empty directory markers belong in a clean checkout.
state/**
!state/**/
!state/README.md
!state/**/.gitkeep

# Claude Code agent worktrees — each one is its own checkout of the repo,
# must never be committed back into the parent tree.
.claude/worktrees/

# Xcode per-user UI state — binary, machine-specific, changes on every open.
xcuserdata/
*.xcuserstate

.claude/scheduled_tasks.lock

# Codex desktop/app-local hooks and session metadata.
.codex/

# Local Netlify folder
.netlify

# Throwaway workspace (reference moodboards, one-off capture scripts)
scratch/
