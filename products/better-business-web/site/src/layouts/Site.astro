---
// Shared site shell for Better Business Web. Owns the whole <html><head>…</head>
// <body class="theme-luminous"> document: fonts + global.css + theme imported
// ONCE here (pages no longer re-declare any of it). Renders, as direct flow
// siblings of <body> (load-bearing for the sticky pin): the scroll-away brand
// banner, a 1px sentinel that drives the nav's stuck state, the sticky <SiteNav>,
// <main id="main"> (the skip-link target), and <SiteFooter>.
import "@fontsource-variable/geist";
import "../styles/global.css";
import "../styles/theme-luminous.css";
import BrandMark from "../components/BrandMark.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  current?: string;
  noindex?: boolean;
  compactBanner?: boolean;
}
const {
  title,
  description,
  ogTitle,
  current,
  noindex = false,
  compactBanner = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body class="theme-luminous">
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- The brand "b" is ONE fixed element pinned to the top-left corner — it never
       moves. The banner and the (stuck) nav each reserve its slot, so the same
       mark appears to live in both while only the wordmark / links scroll past. -->
  <div class="brand-pin">
    <div class="brand-pin__inner">
      <a class="brand-pin__link" href="/" aria-label="Better Business Web — home">
        <BrandMark id="pin" size={32} />
      </a>
    </div>
  </div>

  <header class:list={["brand-banner", compactBanner && "is-compact"]}>
    <a class="brand-banner__link" href="/">
      <span class="brand-banner__slot" aria-hidden="true"></span>
      <span class="brand-banner__word">Better Business Web</span>
    </a>
  </header>

  <div class="sticky-sentinel" aria-hidden="true"></div>

  <SiteNav current={current} />

  <main id="main">
    <slot />
  </main>

  <SiteFooter />

  <style>
    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      background: var(--ink);
      color: var(--paper);
      padding: 0.7rem 1rem;
      border-radius: 10px;
      font-weight: 600;
      z-index: 60;
    }
    .skip-link:focus-visible {
      left: 1rem;
      top: 1rem;
      position: fixed;
      outline: none;
      box-shadow: var(--ring);
    }

    /* Fixed brand mark — pinned to the top-left, never moves, always on top.
       `pointer-events: none` on the overlay; only the mark itself is clickable,
       so it never blocks the wordmark or nav links beneath it. */
    .brand-pin {
      position: fixed;
      inset: 0 0 auto 0;
      height: var(--nav-h);
      z-index: 50;
      pointer-events: none;
    }
    .brand-pin__inner {
      max-width: var(--container);
      height: 100%;
      margin-inline: auto;
      padding-inline: clamp(1.1rem, 0.4rem + 3vw, 2.2rem);
      display: flex;
      align-items: center;
    }
    .brand-pin__link { pointer-events: auto; display: inline-flex; align-items: center; }

    /* Scroll-away brand banner — a slim strip (same height as the nav) holding
       just the wordmark, offset to clear the fixed mark. Scrolls away, no JS. */
    .brand-banner { min-height: var(--nav-h); display: flex; align-items: center; }
    .brand-banner__link {
      display: flex;
      align-items: center;
      gap: var(--brand-gap);
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: clamp(1.1rem, 0.4rem + 3vw, 2.2rem);
      width: 100%;
      color: var(--ink);
    }
    .brand-banner__slot { flex: 0 0 var(--brand-icon-size); width: var(--brand-icon-size); }
    .brand-banner__word {
      font-family: var(--font-display);
      font-weight: 640;
      font-size: clamp(1.35rem, 1.1rem + 1vw, 1.7rem);
      letter-spacing: -0.025em;
      line-height: 1;
    }
    .brand-banner.is-compact .brand-banner__word { font-size: 1.25rem; }

    /* 1px sentinel between banner and nav; the nav's IntersectionObserver watches
       it leave the top to toggle `is-stuck`. */
    .sticky-sentinel { height: 1px; }
  </style>
</body>
</html>
