---
// Shared site shell for Better Business Web. Owns the whole <html><head>…</head>
// <body class="theme-luminous"> document: fonts + global.css + theme imported
// ONCE here (pages no longer re-declare any of it). Renders, as direct flow
// siblings of <body> (load-bearing for the sticky pin): the scroll-away brand
// banner, a 1px sentinel that drives the nav's stuck state, the sticky <SiteNav>,
// <main id="main"> (the skip-link target), and <SiteFooter>.
import "@fontsource-variable/merriweather";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
import "../styles/theme-luminous.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
  current?: string;
  noindex?: boolean;
  compactBanner?: boolean;
  hideHeader?: boolean;
  /** "v2" paints the teal page background on <body> so it flows continuously
   *  into the footer (content keeps the grid overlay; footer stays transparent).
   *  Legacy/legal pages omit it and keep the indigo theme-luminous body. */
  bg?: "default" | "v2";
}
const {
  title,
  description,
  ogTitle,
  ogImage = "/og.png",
  current,
  noindex = false,
  compactBanner = false,
  hideHeader = false,
  bg = "default",
} = Astro.props;

// Absolute URLs for social unfurls (Astro.site is set in astro.config). Without an
// explicit og:image, scrapers grab the first sizeable image on the page — which was a
// demo screenshot, so shared links looked like one of the demo sites, not BBW.
const ogImageUrl = new URL(ogImage, Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
</head>
<body class:list={["theme-luminous", bg === "v2" && "has-v2-bg"]}>
  <a class="skip-link" href="#main">Skip to content</a>

  {!hideHeader && (
    <!-- Brand header — one section (mark + wordmark) that simply scrolls away.
         The nav below it is sticky and pins to the top once this scrolls past. -->
    <header class:list={["brand-banner", compactBanner && "is-compact"]}>
      <a class="brand-banner__link" href="/">
        {/* icon hidden for a test — restore by uncommenting */}
        {/* <BrandMark id="banner" size={compactBanner ? 30 : 40} /> */}
        <span class="brand-banner__word">Better Business Web</span>
      </a>
    </header>
  )}

  <div class="sticky-sentinel" aria-hidden="true"></div>

  <SiteNav current={current} />

  <main id="main">
    <slot />
  </main>

  <SiteFooter />

  <style>
    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      background: var(--ink);
      color: var(--paper);
      padding: 0.7rem 1rem;
      border-radius: 10px;
      font-weight: 600;
      z-index: 60;
    }
    .skip-link:focus-visible {
      left: 1rem;
      top: 1rem;
      position: fixed;
      outline: none;
      box-shadow: var(--ring);
    }

    /* Brand header — a normal in-flow section (mark + wordmark) that scrolls
       away. No JS, nothing fixed; the sticky nav below it does the pinning. */
    .brand-banner { padding-block: clamp(0.8rem, 0.5rem + 1vw, 1.4rem); }
    .brand-banner__link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.3em;
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: clamp(1.1rem, 0.4rem + 3vw, 2.2rem);
      width: 100%;
      color: var(--ink);
      /* Match the oversized footer wordmark (6rem cap) on desktop; the slope is
         tuned so it still fits one line on a phone. The icon scales with it (em). */
      font-size: clamp(1.8rem, 7.5vw, 6rem);
    }
    .brand-banner__link :global(.brand-mark-svg) {
      width: 0.85em;
      height: 0.85em;
      border-radius: 0.16em;
    }
    /* Solid brand tone — a soft, fully-visible periwinkle (not the receding
       faint footer word). */
    .brand-banner__word {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1em;
      letter-spacing: -0.03em;
      line-height: 0.95;
      color: var(--accent-2);
    }
    .brand-banner.is-compact { padding-block: 0.9rem; }
    .brand-banner.is-compact .brand-banner__link { font-size: 1.6rem; }

    /* 1px sentinel between banner and nav; the nav's IntersectionObserver watches
       it leave the top to toggle `is-stuck`. */
    .sticky-sentinel { height: 1px; }
  </style>
</body>
</html>
