---
// Shared landing-page content (theme-agnostic). The four design directions all
// render this same markup; only the stylesheet + fonts differ, so comparisons
// are apples-to-apples. Pricing comes from the catalog SoT via packages.json.
import packages from "../data/packages.json";
import portfolio from "../data/portfolio.json";

const year = new Date().getFullYear();
const featuredId = "package_b";
const fmt = (n) => n.toLocaleString("en-US");

// US states + DC (2-letter) for the review-form State dropdown — normalized
// values make it easy to look the business up by location later.
const US_STATES = ["AL","AK","AZ","AR","CA","CO","CT","DE","DC","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"];

const mockups = portfolio.demos.map((d) => ({
  name: d.name,
  url: `${d.slug}.example.com`,
  thumbnail: d.thumbnail,
  href: d.url,
}));

const pfThemes = [
  "linear-gradient(150deg,#9a3412,#5c1a0a)",
  "linear-gradient(150deg,#1f6f6b,#0f3d3a)",
  "linear-gradient(150deg,#b5701f,#6e3f0e)",
  "linear-gradient(150deg,#2563a8,#15315a)",
  "linear-gradient(150deg,#5b6b3a,#33401f)",
  "linear-gradient(150deg,#b03d73,#5e1c3b)",
  "linear-gradient(150deg,#7c4a2d,#3d2517)",
];
---
<div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
<a class="btn btn-ghost" href="#main" style="position:absolute;left:-9999px;top:auto"
   onfocus="this.style.left='1rem';this.style.top='1rem';this.style.position='fixed';this.style.zIndex='60'">Skip to content</a>

<header class="site-header" id="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">b</span>
      <span>Better Business Web</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#how">How it works</a>
      <a href="#packages">Packages</a>
      <a href="#portfolio">Demos</a>
      <a href="#about">About</a>
    </nav>
    <a class="btn btn-accent nav-cta" href="#get-started" data-magnetic>Get a free review</a>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow" data-reveal>Web design for small businesses</span>
        <h1 data-reveal style="--reveal-delay:0.05s">A better website for your business. <span class="accent">Previewed</span> before you pay.</h1>
        <p class="hero-sub" data-reveal style="--reveal-delay:0.12s">I build clean, modern websites for small businesses. You'll get a real preview link first. See exactly how your new site looks before you pay a cent.</p>
        <div class="hero-actions" data-reveal style="--reveal-delay:0.18s">
          <a class="btn btn-accent btn-lg" href="#get-started" data-magnetic>Get a free website review <span class="arrow">→</span></a>
          <a class="btn btn-ghost btn-lg" href="#portfolio">See demo sites</a>
        </div>
        <p class="hero-note" data-reveal style="--reveal-delay:0.24s"><span class="dot"></span> No commitment. You see the preview first.</p>
        <div class="stats" data-reveal style="--reveal-delay:0.3s">
          <div class="stat"><div class="n"><span data-countup="48">48</span>h</div><div class="l">Typical preview turnaround</div></div>
          <div class="stat"><div class="n">$<span data-countup="0">0</span></div><div class="l">Upfront, until you approve</div></div>
          <div class="stat"><div class="n"><span data-countup={portfolio.demos.length}>{portfolio.demos.length}</span>+</div><div class="l">Industries designed for</div></div>
        </div>
      </div>
      <div class="mock" data-reveal style="--reveal-delay:0.15s">
        <div class="mock-glow" data-parallax data-speed="0.06" aria-hidden="true"></div>
        <div class="hero-carousel" id="hero-carousel" role="group" aria-label="Live previews of demo websites — hover to pause and use the arrows">
          <div class="carousel-3d">
            {mockups.map((m, i) => (
              <a class="carousel-card" href={m.href} target="_blank" rel="noopener" style={`--i:${i}`} aria-label={`Open the ${m.name} demo site`}>
                <span class="cc-bar" aria-hidden="true">
                  <span class="cc-dots"><span></span><span></span><span></span></span>
                  <span class="cc-url">{m.url}</span>
                </span>
                {m.thumbnail ? (
                  <img class="cc-shot" src={m.thumbnail} alt={`${m.name} demo site preview`} loading="lazy" decoding="async" />
                ) : (
                  <span class="cc-fallback">{m.name}</span>
                )}
              </a>
            ))}
          </div>
          <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous demo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="carousel-arrow carousel-next" type="button" aria-label="Next demo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
        <span class="mock-caption"><span class="pulse" aria-hidden="true"></span> Live demos</span>
      </div>
    </div>
  </section>

  <section class="section section--panel">
    <div class="container center">
      <span class="eyebrow" data-reveal>The problem</span>
      <p class="lead" data-reveal style="--reveal-delay:0.08s">Customers look you up before they call. No website, an outdated one, or only a social page, and they quietly <em>move on to the next business.</em></p>
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">How it works</span>
        <h2>Simple. And you see it before you pay.</h2>
      </div>
      <div class="steps">
        <div class="step" data-reveal><span class="num" aria-hidden="true"></span><h3>Tell me about your business</h3><p>A few quick details: what you do, where, and your current site if you have one.</p></div>
        <div class="step" data-reveal><span class="num" aria-hidden="true"></span><h3>I build a real preview</h3><p>I design a clean, modern site for your business and send a live preview link.</p></div>
        <div class="step" data-reveal><span class="num" aria-hidden="true"></span><h3>You review it</h3><p>See exactly how it looks and works. Ask for changes. No pressure, no payment yet.</p></div>
        <div class="step" data-reveal><span class="num" aria-hidden="true"></span><h3>Pay only if you love it</h3><p>Happy with the preview? We go live. That's the whole point: previewed before you pay.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--panel" id="packages">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Packages</span>
        <h2>Straightforward pricing.</h2>
        <p class="muted measure">Ready to go? Pick a package or build your own bundle and pay online. Just browsing? <a href="#get-started">Get a free preview</a> of your site first — no card, no commitment.</p>
      </div>
      <div class="price-grid">
        {packages.bundles.map((b, i) => (
          <article class={b.id === featuredId ? "price-card is-featured" : "price-card"} data-reveal style={`--reveal-delay:${0.06 * i}s`}>
            {b.id === featuredId && <span class="price-badge">Most popular</span>}
            <h3>{b.name}</h3>
            <p class="blurb">{b.description}</p>
            <div class="price">
              <span class="amount" data-countup={b.setup} data-prefix="$">${fmt(b.setup)}</span>
              <span class="per">setup + ${fmt(b.monthly)}/mo</span>
            </div>
            <ul>{b.services.map((s) => <li>{s}</li>)}</ul>
            <a class={b.id === featuredId ? "btn btn-accent" : "btn btn-primary"} href={`/build?preset=${b.id}`} data-magnetic>Start this package <span class="arrow">→</span></a>
          </article>
        ))}
      </div>
      <p class="center muted" style="margin-top:var(--space-md)" data-reveal>Prefer to cherry-pick? <a href="/build">Build your own bundle →</a> and pay for exactly what you choose.</p>
    </div>
  </section>

  <section class="section" id="portfolio">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Demo sites</span>
        <h2>Live demos by business type.</h2>
        <p class="muted measure">Real sample designs built for common local businesses. Click through to explore. The business details are made up. The design work is real.</p>
      </div>
      <div class="portfolio-grid">
        {portfolio.demos.map((d, i) => (
          <a class="pf-card pf-card-link" href={d.url} data-reveal style={`--reveal-delay:${0.05 * i}s`} target="_blank" rel="noopener">
            <div class="pf-top">
              <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span class="pf-url">{d.slug}.example.com</span>
            </div>
            <div class="pf-thumb">
              {d.thumbnail ? (
                <Fragment>
                  <span class="pf-loader" aria-hidden="true"></span>
                  <img src={d.thumbnail} alt={`${d.name} demo site screenshot`} loading="lazy" decoding="async" />
                </Fragment>
              ) : (
                <div class="pf-thumb-fallback" style={`background:${pfThemes[i % pfThemes.length]}`}>
                  <span class="pf-name">{d.name}</span>
                  <span class="pf-kind">{d.type}</span>
                </div>
              )}
            </div>
            <div class="pf-body"><p class="type">{d.type}</p><span class="badge">Live demo</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--panel" id="about">
    <div class="container">
      <div class="about-card" data-reveal>
        <span class="eyebrow">About</span>
        <h2>A small web studio with one set of hands.</h2>
        <p class="muted measure">Better Business Web is run by Kashane Sakhakorn. You work directly with the person designing and building your site. No account managers, no call centers. Just clean, modern websites for small businesses.</p>
        <p class="signature">— Kashane</p>
      </div>
    </div>
  </section>

  <section class="section" id="get-started">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Get started</span>
        <h2>Request your free website review.</h2>
        <p class="muted measure">Tell me a little about your business and I'll put together a preview. No payment, no commitment.</p>
      </div>
      <div class="review-card" data-reveal style="--reveal-delay:0.08s">
        <form name="website-review" method="POST" action="/.netlify/functions/website-review" class="review-form">
          <p hidden><label>Don't fill this out if you're human: <input name="bot-field" aria-label="Leave this field empty" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
          <div class="field"><label for="business">Business name</label><input id="business" name="business" type="text" autocomplete="organization" /></div>
          <div class="field-row">
            <div class="field"><label for="city">City</label><input id="city" name="city" type="text" autocomplete="address-level2" placeholder="e.g. Dahlonega" /></div>
            <div class="field"><label for="state">State</label>
              <select id="state" name="state" autocomplete="address-level1">
                <option value="" selected>Select…</option>
                {US_STATES.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
          </div>
          <div class="field"><label for="website">Current website (or "none")</label><input id="website" name="website" type="text" inputmode="url" placeholder="example.com or none" /></div>
          <div class="field"><label for="contact">Email or phone</label><input id="contact" name="contact" type="text" autocomplete="email" required /></div>
          <button class="btn btn-accent btn-lg" type="submit" data-magnetic>Request my free website review <span class="arrow">→</span></button>
          <p class="form-note">I'll only use these details to prepare your review and get back to you. No spam, no resale.</p>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-word" aria-hidden="true">Better Business Web</div>
    <div class="footer-row">
      <span>© {year} Better Business Web. A small web studio run by Kashane Sakhakorn.</span>
      <span>Previewed before you pay.</span>
    </div>
  </div>
</footer>

<script define:vars={{ mockupUrls: mockups.map((m) => m.url) }}>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fmt = (n) => n.toLocaleString("en-US");
  function countUp(el) {
    const target = parseFloat(el.dataset.countup || "0");
    const prefix = el.dataset.prefix || "";
    if (reduce || target === 0) { el.textContent = prefix + fmt(target); return; }
    const dur = 1100; const start = performance.now();
    function tick(now) {
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = prefix + fmt(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("is-visible");
        e.target.querySelectorAll?.("[data-countup]").forEach(countUp);
        if (e.target.matches?.("[data-countup]")) countUp(e.target);
        io.unobserve(e.target);
      }
    }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  } else {
    document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible"));
    document.querySelectorAll("[data-countup]").forEach(countUp);
  }
  const header = document.getElementById("site-header");
  const bar = document.getElementById("scroll-progress");
  function onScroll() {
    const y = window.scrollY;
    header?.classList.toggle("is-stuck", y > 8);
    if (bar) { const h = document.documentElement.scrollHeight - window.innerHeight; bar.style.width = (h > 0 ? (y / h) * 100 : 0) + "%"; }
  }
  document.addEventListener("scroll", () => requestAnimationFrame(onScroll), { passive: true });
  onScroll();
  if (!reduce) {
    const parallax = [...document.querySelectorAll("[data-parallax]")];
    if (parallax.length) {
      document.addEventListener("scroll", () => requestAnimationFrame(() => {
        const y = window.scrollY;
        for (const el of parallax) el.style.transform = `translateY(${y * parseFloat(el.dataset.speed || "0.1")}px)`;
      }), { passive: true });
    }
    document.querySelectorAll("[data-magnetic]").forEach((el) => {
      el.addEventListener("pointermove", (ev) => {
        const r = el.getBoundingClientRect();
        el.style.transform = `translate(${(ev.clientX - r.left - r.width / 2) * 0.25}px, ${(ev.clientY - r.top - r.height / 2) * 0.35}px)`;
      });
      el.addEventListener("pointerleave", () => { el.style.transform = ""; });
    });
  }
  // Reveal each demo thumbnail once its image decodes; the .pf-loader skeleton
  // + spinner shows until then (and on error, so it never spins forever).
  document.querySelectorAll(".pf-thumb img").forEach((img) => {
    const thumb = img.closest(".pf-thumb");
    if (!thumb) return;
    const reveal = () => thumb.classList.add("is-loaded");
    if (img.complete && img.naturalWidth > 0) reveal();
    else {
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
    }
  });

  // 3D demo carousel: slow auto-spin, pause on hover/focus, arrows step one card.
  (function () {
    const stage = document.getElementById("hero-carousel");
    if (!stage) return;
    const ring = stage.querySelector(".carousel-3d");
    const cards = [...ring.querySelectorAll(".carousel-card")];
    const n = cards.length;
    if (!n) return;
    const step = 360 / n;
    const cardW = parseFloat(getComputedStyle(ring).getPropertyValue("--cc-w")) || 210;
    const radius = Math.round((cardW / 2) / Math.tan(Math.PI / n));
    ring.style.setProperty("--cc-step", step + "deg");
    ring.style.setProperty("--cc-r", radius + "px");

    let angle = 0, raf = null, last = null, paused = false;
    const SPEED = 0.01; // deg/ms — a full turn roughly every 36s
    const apply = () => { ring.style.transform = "rotateY(" + angle + "deg)"; };
    function loop(t) {
      if (last == null) last = t;
      const dt = Math.min(t - last, 60); last = t;
      angle -= dt * SPEED; apply();
      raf = requestAnimationFrame(loop);
    }
    function play() { if (raf || paused || reduce) return; last = null; ring.style.transition = ""; raf = requestAnimationFrame(loop); }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = null; } last = null; }
    function snap(dir) {
      stop();
      ring.style.transition = reduce ? "" : "transform 0.7s cubic-bezier(.22,.7,.2,1)";
      angle += dir * step; apply();
    }
    stage.addEventListener("pointerenter", () => { paused = true; stop(); });
    stage.addEventListener("pointerleave", () => { paused = false; ring.style.transition = ""; play(); });
    stage.addEventListener("focusin", () => { paused = true; stop(); });
    stage.addEventListener("focusout", () => { if (!stage.matches(":hover")) { paused = false; play(); } });
    stage.querySelector(".carousel-prev").addEventListener("click", () => snap(1));
    stage.querySelector(".carousel-next").addEventListener("click", () => snap(-1));
    apply();
    play();
  })();
</script>
