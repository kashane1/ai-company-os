---
// The "b" brand chip — an inline SVG so it paints instantly (no network round-trip
// / FOUT) and can sit in a fixed-width slot without ever causing layout shift.
// `id` must be unique per use on a page (the gradient is referenced by id).
interface Props {
  id?: string;
  size?: number;
  class?: string;
}
const { id = "bbmark", size = 32, class: className = "" } = Astro.props;
const gid = `${id}-grad`;
---
<svg
  class:list={["brand-mark-svg", className]}
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role="img"
  aria-label="Better Business Web"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7c8cff"></stop>
      <stop offset="1" stop-color="#9aa6ff"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${gid})`}></rect>
  <text
    x="16" y="23"
    text-anchor="middle"
    font-family="'Geist Variable', system-ui, sans-serif"
    font-weight="700"
    font-size="20"
    fill="#0a0c12"
  >b</text>
</svg>

<style>
  .brand-mark-svg { display: block; border-radius: 9px; box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4); }
</style>
