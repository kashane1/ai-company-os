---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";

const US_STATES = ["AL","AK","AZ","AR","CA","CO","CT","DE","DC","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"];

const intents = [
  { value: "preview", title: "Preview a new website", desc: "You need a fresh site or want to see a better direction first." },
  { value: "review", title: "Review your current site", desc: "Get honest, plain-English feedback with no jargon and no judgment." },
  { value: "both", title: "Do both", desc: "We'll review what you have, then show you what a better version could look like." },
];

const reviewPoints = [
  ["First impression", "Does the site feel current, trustworthy, and easy to understand?"],
  ["Mobile flow", "Can someone on a phone find the right next action quickly?"],
  ["Clarity", "Is it obvious what you do, where you do it, and why it matters?"],
  ["Trust", "Do reviews, photos, details, and policies make the business feel real?"],
  ["Lead capture", "Is calling, booking, or messaging frictionless enough?"],
  ["Local search", "Are the basics in place for people nearby to find you?"],
];
---

<Site
  title="Get a free website review or preview — Better Business Web"
  description="Request a free preview of a new website, a review of your current one, or both."
  ogTitle="Get a free website review or preview — Better Business Web"
  current="/free-review"
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Free review"
    title="Get a free preview of a better website."
    description="Send us your current site, or just tell us you're starting from scratch. We'll come back with honest, plain-English feedback and a preview of a better version. It's free, and there's no sales call and no obligation."
  >
    <section class="v2-section">
      <div class="v2-shell review-layout">
        <aside class="v2-card v2-card-pad">
          <span class="v2-card-kicker">Review map</span>
          <h2>What we look at first.</h2>
          <ul class="v2-list">
            {reviewPoints.map(([term, body]) => <li><strong>{term}.</strong> {body}</li>)}
          </ul>
        </aside>

        <div class="v2-card v2-card-pad">
          <form name="website-review" method="POST" action="/.netlify/functions/website-review" class="v2-form">
            <p hidden><label>Don't fill this out if you're human: <input name="bot-field" aria-label="Leave this field empty" tabindex="-1" autocomplete="off" /></label></p>

            <fieldset class="intent-v2">
              <legend>How can we help?</legend>
              {intents.map((opt, i) => (
                <label class="intent-option-v2">
                  <input type="radio" name="interest" value={opt.value} required={i === 0 ? true : undefined} />
                  <span>
                    <strong>{opt.title}</strong>
                    <em>{opt.desc}</em>
                  </span>
                </label>
              ))}
            </fieldset>

            <div class="v2-field"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
            <div class="v2-field"><label for="business">Business name</label><input id="business" name="business" type="text" autocomplete="organization" /></div>
            <div class="v2-field-row">
              <div class="v2-field"><label for="city">City</label><input id="city" name="city" type="text" autocomplete="address-level2" placeholder="e.g. Dahlonega" /></div>
              <div class="v2-field"><label for="state">State</label>
                <select id="state" name="state" autocomplete="address-level1">
                  <option value="" selected>Select...</option>
                  {US_STATES.map((state) => <option value={state}>{state}</option>)}
                </select>
              </div>
            </div>
            <div class="v2-field"><label for="website">Current website (or "none")</label><input id="website" name="website" type="text" inputmode="url" placeholder="example.com or none" /></div>
            <div class="v2-field"><label for="contact">Email or phone</label><input id="contact" name="contact" type="text" autocomplete="email" required /></div>
            <button class="v2-btn" type="submit">Get my free review →</button>
            <p class="v2-muted form-note-v2">What happens next: we get back to you within two business days with honest feedback, plus a free preview if you want one. No charge and no sales call.</p>
            <p class="v2-muted form-note-v2">We only use your details to prepare your review. We never sell or share them, and you can ask us to delete them anytime.</p>
          </form>
        </div>
      </div>
    </section>
  </V2Page>
</Site>

<style>
  .review-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(320px, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .review-layout h2 {
    max-width: 9ch;
    font-size: clamp(2.1rem, 4.6vw, 4.4rem);
    line-height: 0.95;
  }

  .intent-v2 {
    display: grid;
    gap: 0.6rem;
    border: 0;
    margin: 0;
    padding: 0;
  }

  .intent-option-v2 {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }

  .intent-option-v2 input {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    margin-top: 0.18rem;
    accent-color: var(--accent);
  }

  .intent-option-v2 strong,
  .intent-option-v2 em {
    display: block;
  }

  .intent-option-v2 strong { color: #ffffff; line-height: 1.1; }
  .intent-option-v2 em { color: var(--ink-faint); font-style: normal; font-size: 0.88rem; margin-top: 0.2rem; }
  .intent-option-v2:has(input:checked) { border-color: color-mix(in srgb, var(--accent) 72%, white); background: rgba(255, 255, 255, 0.12); }
  .form-note-v2 { margin: 0; font-size: var(--step--1); }

  @media (max-width: 900px) {
    .review-layout { grid-template-columns: 1fr; }
  }
</style>
