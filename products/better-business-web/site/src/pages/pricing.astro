---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";
import packages from "../data/packages.json";
import "../components/BundleBuilder.css";
import BundleBuilder from "../components/BundleBuilder.tsx";
import type { BundleBuilderProps } from "../components/BundleBuilder.tsx";

const featuredId = "package_b";
const fmt = (n: number) => n.toLocaleString("en-US");
const bundleList = packages.bundles;
// B and C already say "Everything in A/B, plus…" at the top, so each card lists
// only the services it ADDS over the package before it — no repeated bullets.
const addedServices = (index: number): string[] =>
  index === 0
    ? bundleList[index].services
    : bundleList[index].services.filter(
        (service) => !bundleList[index - 1].services.includes(service),
      );
const builderData = packages as unknown as {
  services: BundleBuilderProps["services"];
  bundles: BundleBuilderProps["bundles"];
  discount_tiers: BundleBuilderProps["discountTiers"];
};
---

<Site
  title="Pricing — Better Business Web"
  description="Straightforward pricing for preview-first small-business websites. Pick a package, build your own bundle, or add a Conversion Lab audit."
  ogTitle="Straightforward pricing — Better Business Web"
  current="/pricing"
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Pricing"
    title="Choose your plan."
    description="Pricing is simple. You pay once to get your site built, then a small monthly fee covers hosting, security, and updates. Buy now to get started, or get a free preview first and decide later. You can cancel the monthly part anytime."
    footerKicker="Not sure yet?"
    footerTitle="See it before you spend a thing."
    footerText="Get a free preview of your new site first. Look it over, then come back and pick the plan that fits."
    footerActions={[
      { href: "/#review", label: "Get a free preview" },
    ]}
  >
    <section class="v2-section">
      <div class="v2-shell">
        <div class="price-grid-v2">
          {packages.bundles.map((bundle, index) => (
            <article class:list={["price-card-v2", "v2-card", bundle.id === featuredId && "is-featured"]}>
              {bundle.id === featuredId && <span class="price-flag">Most popular</span>}
              <span class="v2-card-kicker">{bundle.name}</span>
              <p>{bundle.description}</p>
              <div class="price-number">
                <strong>${fmt(bundle.setup)}</strong>
                <span>setup + ${fmt(bundle.monthly)}/mo</span>
              </div>
              <p class="price-note">The monthly fee covers hosting, security, and small edits. No contract, so you can cancel anytime.</p>
              <ul class="v2-list">
                {addedServices(index).map((service) => <li>{service}</li>)}
              </ul>
              <a class="v2-btn" href="#build" data-preset={bundle.id}>See this package</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-section build-v2" id="build">
      <div class="v2-shell">
        <div class="v2-split">
          <div>
            <span class="v2-eyebrow">Build your own</span>
            <h2>Or build your own bundle.</h2>
          </div>
          <p>Start from a package and add only the pieces that fit. The setup and monthly price update as you go, you own your site and your data, and you can cancel any monthly service whenever you want.</p>
        </div>
      </div>
      <BundleBuilder
        services={builderData.services}
        bundles={builderData.bundles}
        discountTiers={builderData.discount_tiers}
        client:load
      />
    </section>
  </V2Page>
</Site>

<style>
  .price-grid-v2 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.9rem;
  }

  .price-card-v2 {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    align-content: stretch;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.35rem, 2.2vw, 1.8rem) clamp(1.1rem, 2vw, 1.55rem) clamp(1.1rem, 2vw, 1.55rem);
    overflow: visible;
  }

  .price-card-v2.is-featured {
    border-color: color-mix(in srgb, var(--accent) 72%, white);
    background:
      radial-gradient(90% 80% at 50% 0%, rgba(255, 255, 255, 0.18), transparent 62%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(22, 22, 24, 0.5));
  }

  /* The shared .v2-card sets overflow:hidden (for image corners) with higher
     specificity than a bare .price-card-v2, which clipped the flag. Re-show it. */
  .price-card-v2.v2-card.is-featured {
    overflow: visible;
  }

  .price-flag {
    position: absolute;
    top: -0.72rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.34rem 0.85rem;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0a0b;
    font-size: 0.7rem;
    font-weight: 820;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
    z-index: 2;
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.7);
  }

  .price-number {
    padding-block: 0.6rem 1rem;
    border-block: 1px solid var(--line);
  }

  .price-number strong,
  .price-number span {
    display: block;
  }

  .price-number strong {
    color: #ffffff;
    font-size: clamp(3.1rem, 7vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .price-number span {
    color: var(--ink-faint);
    margin-top: 0.45rem;
  }

  .price-note {
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.4;
    margin: 0;
  }

  .price-card-v2 .v2-btn {
    align-self: end;
    width: 100%;
  }

  @media (max-width: 920px) {
    .price-grid-v2 { grid-template-columns: 1fr; }
  }

  /* Bundle builder (merged in from the former /build page) */
  .build-v2 :global(.byo) {
    width: min(100% - clamp(2rem, 6vw, 5rem), 1180px);
    padding: 0;
  }

  .build-v2 :global(.byo-preset),
  .build-v2 :global(.byo-card),
  .build-v2 :global(.byo-cart) {
    border-radius: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(22, 22, 24, 0.42));
    border-color: var(--line);
    box-shadow: var(--shadow-md);
  }

  .build-v2 :global(.byo-cart h2.byo-cart-title) {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.28rem) !important;
    line-height: 1.08 !important;
    overflow-wrap: anywhere;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }

  .build-v2 :global(.byo-preset[data-active="true"]),
  .build-v2 :global(.byo-card[data-selected="true"]) {
    border-color: color-mix(in srgb, var(--accent) 72%, white);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(22, 22, 24, 0.58));
  }

  .build-v2 :global(.byo-buy) {
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 8px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 78%, white), #ededef 42%, #d2d2d6 100%);
    color: #0a0a0b;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), inset 0 -4px 9px rgba(0, 0, 0, 0.26);
  }

  .build-v2 :global(.byo-field input) {
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.065);
  }
</style>

<script>
  // "See this package" cards: smooth-scroll to the builder and preselect that
  // package (via a custom event the builder listens for) — no reload / jump.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const build = document.getElementById("build");
  document.querySelectorAll<HTMLAnchorElement>("a[data-preset]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      const preset = el.dataset.preset;
      if (preset) window.dispatchEvent(new CustomEvent("bbw:preset", { detail: preset }));
      build?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    });
  });
</script>
