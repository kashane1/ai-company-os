---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";
import packages from "../data/packages.json";

const featuredId = "package_b";
const fmt = (n: number) => n.toLocaleString("en-US");
const bundleList = packages.bundles;
// B and C already say "Everything in A/B, plus…" at the top, so each card lists
// only the services it ADDS over the package before it — no repeated bullets.
const addedServices = (index: number): string[] =>
  index === 0
    ? bundleList[index].services
    : bundleList[index].services.filter(
        (service) => !bundleList[index - 1].services.includes(service),
      );
const conversionLabIds = ["conversion_snapshot", "conversion_audit", "ad_copy_lab"];
const conversionLab = packages.services.filter((service) => conversionLabIds.includes(service.id));
const priceLabel = (service: (typeof packages.services)[number]) => {
  const parts = [];
  if (service.setup_cents > 0) parts.push(`$${fmt(service.setup_cents / 100)} setup`);
  if (service.monthly_cents > 0) parts.push(`$${fmt(service.monthly_cents / 100)}/mo`);
  return parts.join(" + ") || "Included";
};
---

<Site
  title="Pricing — Better Business Web"
  description="Straightforward pricing for preview-first small-business websites, bundles, and Conversion Lab add-ons."
  ogTitle="Straightforward pricing — Better Business Web"
  current="/pricing"
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Pricing"
    title="Choose your plan."
    description="Pricing is simple. You pay once to get your site built, then a small monthly fee covers hosting, security, and updates. Buy now to get started, or get a free preview first and decide later. You can cancel the monthly part anytime."
    footerKicker="Ready when you are"
    footerTitle="Build your plan, or see it first."
    footerText="Pick your services and check out whenever you're ready. Not sure yet? Start with a free preview so you can see the work before you spend anything."
    footerActions={[
      { href: "/build", label: "Build your bundle →" },
      { href: "/free-review", label: "Start with a free review", variant: "ghost" },
    ]}
  >
    <section class="v2-section">
      <div class="v2-shell">
        <div class="price-grid-v2">
          {packages.bundles.map((bundle, index) => (
            <article class:list={["price-card-v2", "v2-card", bundle.id === featuredId && "is-featured"]}>
              {bundle.id === featuredId && <span class="price-flag">Most popular</span>}
              <span class="v2-card-kicker">{bundle.name}</span>
              <p>{bundle.description}</p>
              <div class="price-number">
                <strong>${fmt(bundle.setup)}</strong>
                <span>setup + ${fmt(bundle.monthly)}/mo</span>
              </div>
              <p class="price-note">The monthly fee covers hosting, security, and small edits. No contract, so you can cancel anytime.</p>
              <ul class="v2-list">
                {addedServices(index).map((service) => <li>{service}</li>)}
              </ul>
              <a class="v2-btn" href={`/build?preset=${bundle.id}`}>Start this package</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-section">
      <div class="v2-shell">
        <div class="v2-split">
          <div>
            <span class="v2-eyebrow">Conversion Lab</span>
            <h2>Audit before you spend more.</h2>
          </div>
          <p>Use these to check a page or your ad copy before you spend money on it. Pick a quick snapshot, a full review, or a monthly check on your ads.</p>
        </div>
        <div class="v2-grid">
          {conversionLab.map((service) => (
            <article class="v2-card v2-card-pad">
              <span class="v2-card-kicker">{priceLabel(service)}</span>
              <h3>{service.name}</h3>
              <p>{service.blurb}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </V2Page>
</Site>

<style>
  .price-grid-v2 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.9rem;
  }

  .price-card-v2 {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    align-content: stretch;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.35rem, 2.2vw, 1.8rem) clamp(1.1rem, 2vw, 1.55rem) clamp(1.1rem, 2vw, 1.55rem);
    overflow: visible;
  }

  .price-card-v2.is-featured {
    border-color: color-mix(in srgb, var(--accent) 72%, white);
    background:
      radial-gradient(90% 80% at 50% 0%, rgba(255, 255, 255, 0.18), transparent 62%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(22, 22, 24, 0.5));
  }

  /* The shared .v2-card sets overflow:hidden (for image corners) with higher
     specificity than a bare .price-card-v2, which clipped the flag. Re-show it. */
  .price-card-v2.v2-card.is-featured {
    overflow: visible;
  }

  .price-flag {
    position: absolute;
    top: -0.72rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.34rem 0.85rem;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0a0b;
    font-size: 0.7rem;
    font-weight: 820;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
    z-index: 2;
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.7);
  }

  .price-number {
    padding-block: 0.6rem 1rem;
    border-block: 1px solid var(--line);
  }

  .price-number strong,
  .price-number span {
    display: block;
  }

  .price-number strong {
    color: #ffffff;
    font-size: clamp(3.1rem, 7vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .price-number span {
    color: var(--ink-faint);
    margin-top: 0.45rem;
  }

  .price-note {
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.4;
    margin: 0;
  }

  .price-card-v2 .v2-btn {
    align-self: end;
    width: 100%;
  }

  @media (max-width: 920px) {
    .price-grid-v2 { grid-template-columns: 1fr; }
  }
</style>
