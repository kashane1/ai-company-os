---
// Post-submit success page (free-review form → Netlify function → 303 here).
// Closes the conversion moment instead of dumping to Netlify's generic page.
// Not in the nav (no active item); compact banner.
import Site from "../layouts/Site.astro";
---
<Site
  title="Thanks — Better Business Web"
  description="Thanks — we've received your free website review request and will be in touch shortly."
  noindex
  compactBanner
>
  <section class="section">
    <div class="container center stack-lg">
      <span class="eyebrow">Request received</span>
      <h1>Thanks — your review is on the way.</h1>
      <p class="muted measure">I've got your details and I'll start putting together a preview of
        your site. You'll hear back within 2 business days with a link to review — no payment
        until you're happy with it.</p>
      <p><a class="btn btn-primary btn-lg" href="/">Back to home</a></p>
    </div>
  </section>
</Site>

<style>
  .stack-lg > * + * { margin-top: var(--space-md); }
</style>
