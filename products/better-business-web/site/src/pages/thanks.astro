---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";
---

<Site
  title="Thanks — Better Business Web"
  description="Thanks for your request. We've got your free website review and we'll be in touch shortly."
  noindex
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Request received"
    title="Your review is on the way."
    description="We have your details and we're putting your review together. You'll hear back within two business days with what we'd fix first and, when it helps, a preview of a better direction."
    align="center"
    actions={[{ href: "/", label: "Back to home" }]}
  />
</Site>
