---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";
import portfolio from "../data/portfolio.json";
import { featuredDemoSlugs } from "../data/landing-v2.mjs";

type Demo = (typeof portfolio.demos)[number];
const isDemo = (demo: Demo | undefined): demo is Demo => Boolean(demo);
const featuredDemos = featuredDemoSlugs
  .map((slug) => portfolio.demos.find((demo) => demo.slug === slug))
  .filter(isDemo);
const otherDemos = portfolio.demos.filter((demo) => !featuredDemoSlugs.includes(demo.slug));
---

<Site
  title="Live demo sites — Better Business Web"
  description="Explore preview website concepts for local businesses, including auto repair, dog grooming, firearm retail, and a taco restaurant."
  ogTitle="Live demos by business type — Better Business Web"
  current="/demos"
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Demo sites"
    title="Sample sites we've built."
    description="These are concept sites we put together to show our range and the kind of quality you can expect. Open any of them and look around the way one of your customers would."
    footerKicker="Your turn"
    footerTitle="Want a site like these for your business?"
    footerText="Tell us a little about what you do and we'll build a free preview made just for you. There is no charge to see it, and you only pay if you decide to launch."
    footerActions={[
      { href: "/free-review", label: "Get a free preview →" },
      { href: "/pricing", label: "See pricing", variant: "ghost" },
    ]}
  >
    <section class="v2-section">
      <div class="v2-shell">
        <div class="v2-split">
          <div>
            <span class="v2-eyebrow">A few favorites</span>
            <h2>Four very different businesses.</h2>
          </div>
          <p>Don't see your line of work here? We build for any kind of small business. These four are just a quick way to show the range. Sites start at $600 to set up plus $50 a month, and you always get to preview yours before paying.</p>
        </div>

        <div class="demo-grid">
          {featuredDemos.map((demo) => (
            <a class="demo-card v2-card" href={demo.url} target="_blank" rel="noopener">
              <span class="demo-card__top">
                <span class="demo-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>{demo.slug}.preview</span>
              </span>
              <span class="demo-card__image">
                {demo.thumbnail ? <img src={demo.thumbnail} alt={`${demo.name} demo site screenshot`} loading="lazy" decoding="async" /> : null}
              </span>
              <span class="demo-card__body">
                <span>
                  <strong>{demo.name}</strong>
                  <em>{demo.type}</em>
                </span>
                <b>Open</b>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-section">
      <div class="v2-shell">
        <div class="v2-split">
          <div>
            <span class="v2-eyebrow">More concepts</span>
            <h2>A few more to look through.</h2>
          </div>
          <p>These cover other common types of small business. Open any of them and judge the quality for yourself.</p>
        </div>
        <div class="v2-grid">
          {otherDemos.map((demo) => (
            <a class="mini-demo v2-card v2-card-pad" href={demo.url} target="_blank" rel="noopener">
              <span class="v2-card-kicker">{demo.type}</span>
              <h3>{demo.name}</h3>
              <p>{demo.slug}.preview</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </V2Page>
</Site>

<style>
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .demo-card {
    display: grid;
    color: var(--ink);
    min-height: 100%;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .demo-card:hover,
  .mini-demo:hover {
    color: #ffffff;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 70%, white);
  }

  .demo-card__top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 0.72rem;
    min-width: 0;
  }

  .demo-card__dots {
    display: inline-flex;
    gap: 0.28rem;
    flex: 0 0 auto;
  }

  .demo-card__dots i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background:
      radial-gradient(circle at var(--light-from-x) var(--light-from-y), var(--light-specular), transparent 36%),
      linear-gradient(135deg, #ededef, var(--accent) 58%, #161618);
    box-shadow:
      inset 1px -1px 2px rgba(255, 255, 255, 0.32),
      inset -1px 1px 2px rgba(0, 0, 0, 0.34),
      var(--light-cast-x) var(--light-cast-y) 7px var(--light-shadow),
      0 0 12px var(--accent);
  }

  .demo-card__image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(145deg, var(--v2-cyan), var(--v2-black));
  }

  .demo-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(1) contrast(1.03);
    transition: transform 0.24s ease, filter 0.4s ease;
  }

  .demo-card:hover img { transform: scale(1.04); filter: none; }

  .demo-card__body {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
  }

  .demo-card__body strong,
  .demo-card__body em {
    display: block;
  }

  .demo-card__body strong { color: #ffffff; line-height: 1.1; }
  .demo-card__body em { color: var(--ink-faint); font-style: normal; font-size: 0.85rem; margin-top: 0.2rem; }
  .demo-card__body b { color: var(--accent); font-size: 0.85rem; text-transform: none; letter-spacing: 0.02em; }

  .mini-demo {
    color: var(--ink);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .mini-demo h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    line-height: 1;
  }

  @media (max-width: 980px) {
    .demo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .demo-grid { grid-template-columns: 1fr; }
  }
</style>
