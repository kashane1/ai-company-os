---
import Site from "../layouts/Site.astro";
import V2Page from "../components/V2Page.astro";
import "../components/BundleBuilder.css";
import BundleBuilder from "../components/BundleBuilder.tsx";
import type { BundleBuilderProps } from "../components/BundleBuilder.tsx";
import packages from "../data/packages.json";

const builderData = packages as unknown as {
  services: BundleBuilderProps["services"];
  bundles: BundleBuilderProps["bundles"];
  discount_tiers: BundleBuilderProps["discountTiers"];
};
---

<Site
  title="Build your own bundle — Better Business Web"
  description="Pick exactly the website services you want, see the price update live, and start from a v2-styled bundle builder."
  current="/build"
  hideHeader
  bg="v2"
>
  <V2Page
    eyebrow="Build your bundle"
    title="Start with a plan, then add only what you want."
    description="Pick a package below and add the pieces that fit your business. The setup and monthly price update as you go. You own your site and your data, and you can cancel any monthly service whenever you want."
    footerKicker="Still deciding?"
    footerTitle="Prefer to see it before you buy?"
    footerText="Get a free preview of your new site first. Look it over, then come back and pick the plan that fits."
    footerActions={[
      { href: "/free-review", label: "Get a free preview first →" },
      { href: "/pricing", label: "Compare packages", variant: "ghost" },
    ]}
  >
    <section class="v2-section build-v2">
      <BundleBuilder
        services={builderData.services}
        bundles={builderData.bundles}
        discountTiers={builderData.discount_tiers}
        client:load
      />
    </section>
  </V2Page>
</Site>

<style>
  .build-v2 :global(.byo) {
    width: min(100% - clamp(2rem, 6vw, 5rem), 1180px);
    padding: 0;
  }

  .build-v2 :global(.byo-preset),
  .build-v2 :global(.byo-card),
  .build-v2 :global(.byo-cart) {
    border-radius: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(22, 22, 24, 0.42));
    border-color: var(--line);
    box-shadow: var(--shadow-md);
  }

  .build-v2 :global(.byo-cart h2.byo-cart-title) {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.28rem) !important;
    line-height: 1.08 !important;
    overflow-wrap: anywhere;
    text-transform: none !important;
    letter-spacing: 0 !important;
  }

  .build-v2 :global(.byo-preset[data-active="true"]),
  .build-v2 :global(.byo-card[data-selected="true"]) {
    border-color: color-mix(in srgb, var(--accent) 72%, white);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(22, 22, 24, 0.58));
  }

  .build-v2 :global(.byo-buy) {
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 8px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 78%, white), #ededef 42%, #d2d2d6 100%);
    color: #0a0a0b;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), inset 0 -4px 9px rgba(0, 0, 0, 0.26);
  }

  .build-v2 :global(.byo-field input) {
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.065);
  }
</style>
