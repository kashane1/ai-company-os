---
// Build-Your-Own-Bundle — interactive configurator + buy-now. Single React
// island; the rest stays static Astro. Pricing data is the drift-guarded
// packages.json (one source of truth, integer cents). Linked from /pricing;
// not in the nav, so no active item.
import Site from "../layouts/Site.astro";
import "../components/BundleBuilder.css";
import BundleBuilder from "../components/BundleBuilder.tsx";
import packages from "../data/packages.json";
---
<Site
  title="Build your own bundle — Better Business Web"
  description="Pick exactly the services you want, see the price update live, and start today. Cancel anytime."
  current="/build"
>
  <div class="byo-page">
    <header class="byo-hero">
      <h1>Build your own bundle</h1>
      <p>
        Pick exactly what you need and the price updates as you go. Setup is a
        one-time cost and the monthly covers the ongoing work. Start from a package
        or build from scratch, and cancel anytime.
      </p>
    </header>

    <BundleBuilder
      services={packages.services}
      bundles={packages.bundles}
      discountTiers={packages.discount_tiers}
      client:load
    />
  </div>
</Site>

<style>
  .byo-page { padding: var(--space-lg) 0 var(--space-xl); }
  .byo-hero {
    max-width: var(--container);
    margin: 0 auto var(--space-lg);
    padding: 0 var(--space-md);
  }
  .byo-hero h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin: 0 0 var(--space-xs);
  }
  .byo-hero p {
    max-width: 60ch;
    color: var(--ink-soft);
    margin: 0;
  }
</style>
