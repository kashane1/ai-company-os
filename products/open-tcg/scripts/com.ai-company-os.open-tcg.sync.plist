<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenTCG scheduled sync, every 15 minutes. "radar sync" polls only the sources
  that are due: PokeBeach every 15 min, Southern Hobby daily, tcgcsv once after
  its ~20:00 UTC nightly rebuild. A run with nothing due exits without network.

  Install / remove with products/open-tcg/scripts/launchd.sh install|uninstall.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-company-os.open-tcg.sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/kashane/dev/ai-company-os/products/open-tcg/.venv/bin/python</string>
    <string>-m</string>
    <string>radar</string>
    <string>sync</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kashane/dev/ai-company-os/products/open-tcg</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/kashane/dev/ai-company-os/products/open-tcg/data/logs/sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kashane/dev/ai-company-os/products/open-tcg/data/logs/sync.err.log</string>
</dict>
</plist>
